# 本机跑不需要这个文件；部署到 Vercel 时在面板里配置同名变量。
# 复制成 .env 仅供本地调试（不要提交）。
ALLOW_ORIGINS=*

# 账号系统：签 JWT 用的密钥，生产必须换成随机长字符串
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
# JWT_SECRET=

# SQLite 文件位置，默认 server/data.db
# STUDYFLOW_DB=

# DEEPSEEK_API_KEY=sk-xxx
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
